//从标准输入读取一行文本并转换为数字，赋值给变量n
n := File standardInput readLine asNumber
m := n//将n的值复制给变量m，用于最后输出原始值
//当n大于1时执行循环（即还有数字需要分解）
while(n > 1,
    for(p, n, 2, -1, //从n开始向下到2进行循环，p是当前检查的数字 寻找不大于当前n的最大素
        x := 2 //初始化变量x为2（用于素数检测的除数）
        pr := 1 //初始化变量pr为1（标记是否为素数，1表示是素数）
        while(x * x <= p,
            if(p % x == 0, //如果p能被x整除，则p不是素数，设置pr为0并跳出循环
                pr = 0
                break
            )
            x = x + 1 //检查下一个除数
        )
        if(pr == 0, continue) //如果pr为0（不是素数），则跳过本次循环，检查下一个较小的数字
        p print //输出找到的素数p
        if(p != n, "+" print) //如果p不等于原始的n值，则输出加号"+"（表示还有更多项）
        n = n - p //从n中减去已找到的素数p，继续分解剩余的部分
        break //跳出for循环，重新开始while循环处理新的n值
    )
)//如果最后剩余的n等于1，则输出1（这种情况理论上不会发生，因为哥德巴赫猜想表明大于2的偶数都可以表示为两个素数之和）
if(n == 1, 1 print)
"=" print //输出等号"="
m println //输出原始的数字m并换行