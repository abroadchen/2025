/*
检查是否存在非法的2×2模式：
检查模式：左上和右下都有''，或者右上和左下都有''
这些模式无法用标准俄罗斯方块拼成
如果发现，立即返回0（NO）

从l=4开始向下循环到l=0
l表示方块的尺寸（4: tetromino, 3: tromino, 2: domino, 1: monomino, 0: dot）
每轮开始时c=0重置计数器
遍历10×10网格的每个位置
i是行索引，j是列索引
j + l < 10确保不会越界

检查水平方向的长度为l+1的线段是否全是'*'
如果是，则计数器c增加，并将这些位置标记为'0'（表示已处理）
检查垂直方向的长度为l+1的线段是否全是'*'
如果是，则计数器c增加，并将这些位置标记为'0'

如果是4格方块(l=4)且找到了(c>0)，返回0（因为题目要求不能有4格方块）
如果l + c ≠ 4，返回0（每轮要求特定的方块数量组合）


u = 1：初始化标志变量u为真（1），表示"假设所有字符都是'*'"
k = 0：初始化循环变量k为0
k <= l：k从0到l（包含l），检查l+1个连续位置
u：如果u变为假（0），立即停止循环（短路求值）
p[j + k][i]：访问网格位置，第(j+k)行，第i列
== '*'：检查该位置是否为'*'字符
u && ...：只有当u仍为真且当前位置是'*'时，u才保持为真
u & ...：按位与操作，只有当u和条件都为真时，u才保持为真
*/
int solve() {
    int i, j, k, l, u, c;
    array(string) p = allocate(11);
    for (i = 0; i <= 10; ++i) p[i] = Stdio.stdin.gets();
    for (i = 0; i < 9; ++i) {
        for (j = 0; j < 9; ++j) {
            if (p[i][j] == '*' && p[i + 1][j + 1] == '*' ||
                p[i][j + 1] == '*' && p[i + 1][j] == '*')
                return 0;
        }
    }
    for (l = 4; c = 0, l >= 0; --l) {
        for (i = 0; i < 10; ++i) {
            for (j = 0; j + l < 10; ++j) {
                for (u = 1, k = 0; k <= l && u; ++k)
                    u &= p[i][j + k] == '*';//行不变，列变化
                if (u) {
                    c++;
                    for (k = 0; k <= l; ++k) p[i][j + k] = '0';
                }
                for (u = 1, k = 0; k <= l && u; ++k)
                    u = u && p[j + k][i] == '*';//列不变，行变化
                if (u) {
                    c++;
                    for (k = 0; k <= l; ++k) p[j + k][i] = '0';
                }
            }
        }
        if (l == 4 && c) return 0;
        if (4 != l + c) return 0;
    }
    return 1;
}


int main() {
    for (int m = (int)Stdio.stdin.gets(); m--;)
        write(solve() ? "YES\n" : "NO\n");
    return 0;
}